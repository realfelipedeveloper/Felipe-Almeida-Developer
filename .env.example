# ============================================================
# Felipe Almeida Developer — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.
# ============================================================

# ---------- Geral ----------
NODE_ENV=development
APP_NAME="Felipe Almeida Developer"
DEFAULT_LOCALE=pt-BR
SUPPORTED_LOCALES=pt-BR,en,es

# ---------- Portas ----------
WEB_PORT=3000
API_PORT=3333
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- URLs ----------
WEB_URL=http://localhost:3000
API_URL=http://localhost:3333
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origens adicionais autorizadas a acessar a API pelo navegador.
# Separe múltiplas origens por vírgula. WEB_URL já é incluída automaticamente.
CORS_ALLOWED_ORIGINS=

# ---------- Hardening HTTP ----------
# Ative somente quando a API estiver atrás de um proxy reverso confiável.
TRUST_PROXY=false

# Swagger fica disponível por padrão fora de produção.
# Em produção, só é exposto quando SWAGGER_ENABLED=true explicitamente.
SWAGGER_ENABLED=true

# Limite aplicado aos corpos JSON e urlencoded recebidos pela API.
API_BODY_LIMIT=64kb

# ---------- Mídia ----------
# Use local somente em desenvolvimento. Produção exige s3/object_storage.
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_ROOT=./var/media
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_PDF_BYTES=20971520
# Limite de pixels decodificados evita imagens-bomba; limite público é por IP/minuto.
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_RATE_LIMIT_PER_MINUTE=240
# Janela antes de considerar um upload PENDING abandonado (15 a 1440 minutos).
MEDIA_PENDING_UPLOAD_GRACE_MINUTES=60
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
# Endpoint opcional para provedores S3-compatible (MinIO, R2 etc.).
MEDIA_S3_ENDPOINT=
MEDIA_S3_FORCE_PATH_STYLE=false
# Credenciais seguem a cadeia padrão do AWS SDK; estas variáveis são opcionais
# quando a infraestrutura fornece uma role/identidade de workload.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Antivírus é obrigatório em produção. O scanner ClamAV deve aceitar INSTREAM.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# ---------- PostgreSQL ----------
POSTGRES_USER=fad
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fad
DATABASE_URL=postgresql://fad:troque-esta-senha@localhost:5432/fad?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- RabbitMQ ----------
RABBITMQ_USER=fad
RABBITMQ_PASSWORD=troque-esta-senha
RABBITMQ_URL=amqp://fad:troque-esta-senha@localhost:5672

# ---------- Autenticação ----------
JWT_ACCESS_SECRET=gere-com-openssl-rand-hex-64
JWT_REFRESH_SECRET=gere-com-openssl-rand-hex-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ADMIN_EMAIL=TODO@seu-email.com
ADMIN_INITIAL_PASSWORD=troque-no-primeiro-login

# ---------- Privacidade / tokens públicos ----------
# Gere valores aleatórios fortes e distintos; os segredos de privacidade são obrigatórios em produção.
PRIVACY_HASH_SECRET=
PRIVACY_REQUEST_TOKEN_SECRET=
NEWSLETTER_TOKEN_SECRET=
PASSWORD_RESET_TOKEN_SECRET=

# ---------- E-mail ----------
# Em desenvolvimento, SMTP aponta para o Mailpit.
# Em produção, EMAIL_PROVIDER=sendgrid é a opção recomendada neste projeto.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Felipe Almeida Developer <no-reply@TODO-dominio.com>"
CONTACT_INBOX=TODO@seu-email.com

# SendGrid (usado quando EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# ---------- WhatsApp Cloud API ----------
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=TODO
WHATSAPP_ACCESS_TOKEN=TODO
WHATSAPP_TO_NUMBER=TODO-55DDDNUMERO

# ---------- Analytics ----------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---------- Captcha / anti-bot ----------
# O widget só aparece quando NEXT_PUBLIC_TURNSTILE_SITE_KEY estiver configurada.
# A API só exige validação quando TURNSTILE_SECRET_KEY estiver configurada.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Script opcional de analytics; só é carregado após consentimento explícito.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
# Origens HTTPS externas separadas por vírgula; mesma origem já é permitida.
NEXT_PUBLIC_ANALYTICS_ALLOWED_ORIGINS=
TURNSTILE_SECRET_KEY=

# ---------- Logs / observabilidade ----------
LOG_LEVEL=debug
LOG_DIR=./logs
METRICS_ENABLED=true
# Em produção, se METRICS_ENABLED não for false, METRICS_TOKEN é obrigatório.
METRICS_TOKEN=
WORKER_MANAGEMENT_HOST=127.0.0.1
WORKER_MANAGEMENT_PORT=9464

# ---------- Backup ----------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
