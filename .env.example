# ============================================================
#  Felipe Almeida Developer — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env real.
# ============================================================

# ---------- Geral ----------
NODE_ENV=development
APP_NAME="Felipe Almeida Developer"
DEFAULT_LOCALE=pt-BR
SUPPORTED_LOCALES=pt-BR,en,es

# ---------- Portas (verificadas por pnpm check:ports) ----------
WEB_PORT=3000
API_PORT=3333
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------- URLs ----------
WEB_URL=http://localhost:3000
API_URL=http://localhost:3333
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- PostgreSQL ----------
POSTGRES_USER=fad
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fad
DATABASE_URL=postgresql://fad:troque-esta-senha@localhost:5432/fad?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- RabbitMQ ----------
RABBITMQ_USER=fad
RABBITMQ_PASSWORD=troque-esta-senha
RABBITMQ_URL=amqp://fad:troque-esta-senha@localhost:5672

# ---------- Autenticação ----------
JWT_ACCESS_SECRET=gere-com-openssl-rand-hex-64
JWT_REFRESH_SECRET=gere-com-openssl-rand-hex-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ADMIN_EMAIL=TODO@seu-email.com
ADMIN_INITIAL_PASSWORD=troque-no-primeiro-login

# ---------- E-mail (dev usa Mailpit) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Felipe Almeida Developer <no-reply@TODO-dominio.com>"
CONTACT_INBOX=TODO@seu-email.com

# ---------- WhatsApp Cloud API ----------
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=TODO
WHATSAPP_ACCESS_TOKEN=TODO
WHATSAPP_TO_NUMBER=TODO-55DDDNUMERO

# ---------- Analytics (só carrega após consentimento LGPD) ----------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---------- Captcha ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Logs ----------
LOG_LEVEL=debug
LOG_DIR=./logs

# ---------- Backup ----------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
