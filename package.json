{
  "name": "felipe-almeida-developer",
  "private": true,
  "version": "0.8.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "preinstall": "node infra/scripts/enforce-pnpm.mjs",
    "prepare": "node infra/scripts/setup-husky.mjs",
    "check:ports": "node infra/scripts/check-ports.mjs",
    "predev": "pnpm check:ports --apps-only",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:ops",
    "test:coverage": "pnpm --filter @fad/api test:coverage",
    "test:ops": "node --test infra/scripts/backup-crypto.test.mjs",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "audit:prod": "pnpm audit --prod --audit-level=moderate",
    "audit:all": "pnpm audit --audit-level=critical",
    "quality": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:coverage && pnpm build && pnpm test:e2e",
    "format": "prettier --write .",
    "infra:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/docker/docker-compose.yml logs -f",
    "infra:prod:config": "docker compose --env-file .env -f infra/docker/docker-compose.prod.yml config --quiet",
    "infra:prod:build": "docker compose --env-file .env -f infra/docker/docker-compose.prod.yml build",
    "db:generate": "pnpm --filter @fad/api db:generate",
    "db:validate": "pnpm --filter @fad/api db:validate",
    "db:migrate:dev": "pnpm --filter @fad/api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @fad/api db:migrate:deploy",
    "db:seed": "pnpm --filter @fad/api db:seed",
    "db:studio": "pnpm --filter @fad/api db:studio",
    "db:setup": "pnpm db:generate && pnpm db:validate && pnpm db:migrate:deploy && pnpm db:seed && pnpm db:check",
    "db:backup": "node infra/scripts/run-bash.mjs infra/scripts/backup.sh",
    "db:restore": "node infra/scripts/run-bash.mjs infra/scripts/restore.sh",
    "sdd:check": "node infra/scripts/sdd-check.mjs",
    "github:check": "node infra/scripts/github-check.mjs",
    "db:check": "pnpm --filter @fad/api db:check",
    "security:audit-rich-text": "pnpm --filter @fad/api security:audit-rich-text",
    "security:sanitize-rich-text": "pnpm --filter @fad/api security:sanitize-rich-text"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml,css}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "next@15.5.27>postcss": "8.5.29",
      "source-map-js": "1.2.2",
      "@prisma/config@6.19.0>effect": "3.20.0",
      "@prisma/config@6.19.0>deepmerge-ts": "8.0.2",
      "@nestjs/swagger@11.4.7>js-yaml": "5.4.2",
      "vitest@4.1.11>vite": "6.4.3",
      "@vitest/mocker@4.1.11>vite": "6.4.3",
      "ts-jest@29.4.14>handlebars": "4.7.10",
      "postcss-selector-parser": "7.1.6"
    }
  }
}
