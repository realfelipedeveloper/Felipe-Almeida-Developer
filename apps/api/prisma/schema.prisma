generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Locale {
  PT_BR @map("pt-BR")
  EN    @map("en")
  ES    @map("es")
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectLifecycle {
  PLANNED
  IN_PROGRESS
  ACTIVE
  COMPLETED
  MAINTENANCE
  PAUSED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum NewsletterSubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

enum NewsletterTokenPurpose {
  CONFIRM_SUBSCRIPTION
  UNSUBSCRIBE
}

enum MediaKind {
  IMAGE
  PDF
}

enum MediaStorageProvider {
  LOCAL
  OBJECT_STORAGE
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum PrivacyRequestType {
  EXPORT
  DELETE
}

enum PrivacyRequestStatus {
  PENDING
  VERIFIED
  PROCESSING
  COMPLETED
  REJECTED
  EXPIRED
}

enum ConsentCategory {
  ANALYTICS
}

model Profile {
  id               String               @id @default(uuid()) @db.Uuid
  publicEmail      String?              @map("public_email") @db.VarChar(320)
  publicLocation   String?              @map("public_location") @db.VarChar(160)
  availableForWork Boolean              @default(true) @map("available_for_work")
  avatarMediaId    String?              @map("avatar_media_id") @db.Uuid
  resumeMediaId    String?              @map("resume_media_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  avatarMedia  MediaAsset?          @relation("ProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  resumeMedia  MediaAsset?          @relation("ProfileResume", fields: [resumeMediaId], references: [id], onDelete: SetNull)
  translations ProfileTranslation[]
  socialLinks  SocialLink[]
  articles     Article[]

  @@map("profiles")
}

model ProfileTranslation {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  locale    Locale
  fullName  String   @map("full_name") @db.VarChar(160)
  headline  String   @db.VarChar(220)
  summary   String   @db.Text
  bio       String   @db.Text
  seoTitle  String?  @map("seo_title") @db.VarChar(180)
  seoDescription String? @map("seo_description") @db.VarChar(320)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, locale])
  @@index([locale])
  @@map("profile_translations")
}

model SocialLink {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  label     String   @db.VarChar(80)
  url       String   @db.VarChar(500)
  iconKey   String?  @map("icon_key") @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  visible   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, visible, sortOrder])
  @@map("social_links")
}

model Project {
  id                String             @id @default(uuid()) @db.Uuid
  publicationStatus PublicationStatus  @default(DRAFT) @map("publication_status")
  lifecycle         ProjectLifecycle   @default(IN_PROGRESS)
  featured          Boolean            @default(false)
  startedAt         DateTime?          @map("started_at") @db.Date
  endedAt           DateTime?          @map("ended_at") @db.Date
  repositoryUrl     String?            @map("repository_url") @db.VarChar(500)
  demoUrl           String?            @map("demo_url") @db.VarChar(500)
  coverMediaId      String?            @map("cover_media_id") @db.Uuid
  sortOrder         Int                @default(0) @map("sort_order")
  publishedAt       DateTime?          @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  coverMedia    MediaAsset?          @relation("ProjectCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  translations ProjectTranslation[]
  technologies ProjectTechnology[]
  tags          ProjectTag[]
  media         ProjectMedia[]

  @@index([publicationStatus, featured, sortOrder])
  @@index([lifecycle])
  @@map("projects")
}

model ProjectTranslation {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  locale         Locale
  title          String   @db.VarChar(180)
  slug           String   @db.VarChar(200)
  summary        String   @db.Text
  description    String   @db.Text
  challenges     String?  @db.Text
  solution       String?  @db.Text
  results        String?  @db.Text
  seoTitle       String?  @map("seo_title") @db.VarChar(180)
  seoDescription String?  @map("seo_description") @db.VarChar(320)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@unique([locale, slug])
  @@index([locale, title])
  @@map("project_translations")
}

model Technology {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(120)
  slug       String   @unique @db.VarChar(140)
  category   String?  @db.VarChar(100)
  websiteUrl String?  @map("website_url") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  projects ProjectTechnology[]

  @@map("technologies")
}

model ProjectTechnology {
  projectId    String @map("project_id") @db.Uuid
  technologyId String @map("technology_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
  @@map("project_technologies")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations TagTranslation[]
  projects     ProjectTag[]
  articles     ArticleTag[]
  news         NewsTag[]

  @@map("tags")
}

model TagTranslation {
  id        String   @id @default(uuid()) @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  locale    Locale
  label     String   @db.VarChar(120)
  slug      String   @db.VarChar(140)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@unique([locale, slug])
  @@map("tag_translations")
}

model ProjectTag {
  projectId String @map("project_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
  @@map("project_tags")
}

model ProjectMedia {
  projectId    String @map("project_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([projectId, mediaAssetId])
  @@index([mediaAssetId])
  @@map("project_media")
}

model Article {
  id                String            @id @default(uuid()) @db.Uuid
  publicationStatus PublicationStatus @default(DRAFT) @map("publication_status")
  authorProfileId   String?           @map("author_profile_id") @db.Uuid
  coverMediaId      String?           @map("cover_media_id") @db.Uuid
  readingTimeMinutes Int?             @map("reading_time_minutes")
  scheduledAt       DateTime?         @map("scheduled_at") @db.Timestamptz(3)
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  authorProfile Profile?             @relation(fields: [authorProfileId], references: [id], onDelete: SetNull)
  coverMedia    MediaAsset?          @relation("ArticleCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  translations ArticleTranslation[]
  tags          ArticleTag[]

  @@index([publicationStatus, publishedAt])
  @@index([scheduledAt])
  @@map("articles")
}

model ArticleTranslation {
  id             String   @id @default(uuid()) @db.Uuid
  articleId      String   @map("article_id") @db.Uuid
  locale         Locale
  title          String   @db.VarChar(180)
  slug           String   @db.VarChar(200)
  summary        String   @db.Text
  bodyHtml       String   @map("body_html") @db.Text
  seoTitle       String?  @map("seo_title") @db.VarChar(180)
  seoDescription String?  @map("seo_description") @db.VarChar(320)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@unique([locale, slug])
  @@index([locale, title])
  @@map("article_translations")
}

model ArticleTag {
  articleId String @map("article_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

model News {
  id                String            @id @default(uuid()) @db.Uuid
  publicationStatus PublicationStatus @default(DRAFT) @map("publication_status")
  coverMediaId      String?           @map("cover_media_id") @db.Uuid
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  coverMedia    MediaAsset?      @relation("NewsCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  translations NewsTranslation[]
  tags          NewsTag[]

  @@index([publicationStatus, publishedAt])
  @@map("news")
}

model NewsTranslation {
  id             String   @id @default(uuid()) @db.Uuid
  newsId         String   @map("news_id") @db.Uuid
  locale         Locale
  title          String   @db.VarChar(180)
  slug           String   @db.VarChar(200)
  summary        String   @db.Text
  contentHtml    String   @map("content_html") @db.Text
  seoTitle       String?  @map("seo_title") @db.VarChar(180)
  seoDescription String?  @map("seo_description") @db.VarChar(320)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, locale])
  @@unique([locale, slug])
  @@index([locale, title])
  @@map("news_translations")
}

model NewsTag {
  newsId String @map("news_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsId, tagId])
  @@index([tagId])
  @@map("news_tags")
}

model ContactMessage {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(160)
  email         String        @db.VarChar(320)
  subject       String        @db.VarChar(200)
  message       String        @db.Text
  locale        Locale        @default(PT_BR)
  status        ContactStatus @default(NEW)
  ipHash        String?       @map("ip_hash") @db.VarChar(128)
  correlationId String        @default(uuid()) @map("correlation_id") @db.Uuid
  resolvedAt    DateTime?     @map("resolved_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([email])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id             String                     @id @default(uuid()) @db.Uuid
  email          String                     @unique @db.VarChar(320)
  locale         Locale                     @default(PT_BR)
  status         NewsletterSubscriberStatus @default(PENDING)
  consentSource  String?                    @map("consent_source") @db.VarChar(160)
  consentIpHash  String?                    @map("consent_ip_hash") @db.VarChar(128)
  confirmedAt    DateTime?                  @map("confirmed_at") @db.Timestamptz(3)
  unsubscribedAt DateTime?                  @map("unsubscribed_at") @db.Timestamptz(3)
  bounceReason   String?                    @map("bounce_reason") @db.VarChar(240)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tokens NewsletterToken[]

  @@index([status, locale])
  @@map("newsletter_subscribers")
}

model NewsletterToken {
  id           String                 @id @default(uuid()) @db.Uuid
  subscriberId String                 @map("subscriber_id") @db.Uuid
  purpose      NewsletterTokenPurpose
  tokenHash    String                 @unique @map("token_hash") @db.VarChar(128)
  expiresAt    DateTime               @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime?              @map("used_at") @db.Timestamptz(3)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId, purpose, expiresAt])
  @@map("newsletter_tokens")
}

model NewsletterIssue {
  id                String            @id @default(uuid()) @db.Uuid
  publicationStatus PublicationStatus @default(DRAFT) @map("publication_status")
  scheduledAt       DateTime?         @map("scheduled_at") @db.Timestamptz(3)
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations NewsletterIssueTranslation[]

  @@index([publicationStatus, publishedAt])
  @@map("newsletter_issues")
}

model NewsletterIssueTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  issueId     String   @map("issue_id") @db.Uuid
  locale      Locale
  subject     String   @db.VarChar(220)
  previewText String?  @map("preview_text") @db.VarChar(320)
  bodyHtml    String   @map("body_html") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  issue NewsletterIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, locale])
  @@map("newsletter_issue_translations")
}

model AdminUser {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique @db.VarChar(320)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               AdminRole @default(ADMIN)
  active             Boolean   @default(false)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploadedMedia MediaAsset[]
  auditLogs     AuditLog[]

  @@map("admin_users")
}

model MediaAsset {
  id               String               @id @default(uuid()) @db.Uuid
  kind             MediaKind
  storageProvider  MediaStorageProvider @default(LOCAL) @map("storage_provider")
  storageKey       String               @unique @map("storage_key") @db.VarChar(500)
  originalName     String               @map("original_name") @db.VarChar(255)
  mimeType         String               @map("mime_type") @db.VarChar(160)
  extension        String?              @db.VarChar(20)
  byteSize         BigInt               @map("byte_size")
  sha256           String               @db.VarChar(64)
  width            Int?
  height           Int?
  createdByAdminId String?              @map("created_by_admin_id") @db.Uuid
  metadata         Json?
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(3)

  createdByAdmin AdminUser?         @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  translations  MediaTranslation[]
  profileAvatars Profile[]          @relation("ProfileAvatar")
  profileResumes Profile[]          @relation("ProfileResume")
  projectCovers  Project[]          @relation("ProjectCover")
  projectMedia   ProjectMedia[]
  articleCovers  Article[]          @relation("ArticleCover")
  newsCovers     News[]             @relation("NewsCover")

  @@index([kind, deletedAt])
  @@index([sha256])
  @@map("media_assets")
}

model MediaTranslation {
  id           String   @id @default(uuid()) @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  locale       Locale
  title        String?  @db.VarChar(180)
  altText      String?  @map("alt_text") @db.VarChar(320)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, locale])
  @@map("media_translations")
}

model SeoPageMetadata {
  id             String   @id @default(uuid()) @db.Uuid
  pageKey        String   @map("page_key") @db.VarChar(100)
  locale         Locale
  title          String   @db.VarChar(180)
  description    String   @db.VarChar(320)
  canonicalPath  String?  @map("canonical_path") @db.VarChar(300)
  ogTitle        String?  @map("og_title") @db.VarChar(180)
  ogDescription  String?  @map("og_description") @db.VarChar(320)
  noIndex        Boolean  @default(false) @map("no_index")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([pageKey, locale])
  @@index([locale, noIndex])
  @@map("seo_page_metadata")
}

model ConsentRecord {
  id            String          @id @default(uuid()) @db.Uuid
  subjectKey    String          @map("subject_key") @db.VarChar(128)
  category      ConsentCategory
  granted       Boolean
  policyVersion String          @map("policy_version") @db.VarChar(40)
  locale        Locale          @default(PT_BR)
  source        String?         @db.VarChar(120)
  ipHash        String?         @map("ip_hash") @db.VarChar(128)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subjectKey, category, createdAt])
  @@map("consent_records")
}

model PrivacyRequest {
  id                    String               @id @default(uuid()) @db.Uuid
  email                 String               @db.VarChar(320)
  type                  PrivacyRequestType
  status                PrivacyRequestStatus @default(PENDING)
  verificationTokenHash String?              @unique @map("verification_token_hash") @db.VarChar(128)
  verificationExpiresAt DateTime?            @map("verification_expires_at") @db.Timestamptz(3)
  verifiedAt            DateTime?            @map("verified_at") @db.Timestamptz(3)
  completedAt           DateTime?            @map("completed_at") @db.Timestamptz(3)
  resultStorageKey      String?              @map("result_storage_key") @db.VarChar(500)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([email, status])
  @@map("privacy_requests")
}

model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventName     String   @map("event_name") @db.VarChar(160)
  version       Int      @default(1)
  aggregateType String?  @map("aggregate_type") @db.VarChar(120)
  aggregateId   String?  @map("aggregate_id") @db.VarChar(120)
  correlationId String   @default(uuid()) @map("correlation_id") @db.Uuid
  payload       Json
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  availableAt   DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int      @default(0)
  lastError     String?  @map("last_error") @db.Text

  @@index([publishedAt, availableAt])
  @@index([eventName, occurredAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  consumer    String   @db.VarChar(160)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@unique([eventId, consumer])
  @@index([consumer, processedAt])
  @@map("processed_events")
}

model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  actorAdminId   String?   @map("actor_admin_id") @db.Uuid
  action         String    @db.VarChar(160)
  resourceType   String    @map("resource_type") @db.VarChar(120)
  resourceId     String?   @map("resource_id") @db.VarChar(120)
  correlationId  String?   @map("correlation_id") @db.Uuid
  ipHash         String?   @map("ip_hash") @db.VarChar(128)
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  actorAdmin AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([actorAdminId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@map("audit_logs")
}

model SiteSetting {
  key       String   @id @db.VarChar(120)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}
