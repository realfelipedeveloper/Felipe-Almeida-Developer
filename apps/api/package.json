{
  "name": "@fad/api",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "dev": "node ../../infra/scripts/run-with-env.mjs nest start --watch",
    "build": "nest build",
    "start": "node ../../infra/scripts/run-with-env.mjs node dist/main.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --config ./jest.coverage.config.cjs --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "db:generate": "node ../../infra/scripts/run-with-env.mjs prisma generate --schema prisma/schema.prisma",
    "db:validate": "node ../../infra/scripts/run-with-env.mjs prisma validate --schema prisma/schema.prisma",
    "db:migrate:dev": "node ../../infra/scripts/run-with-env.mjs prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "node ../../infra/scripts/run-with-env.mjs prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "node ../../infra/scripts/run-with-env.mjs prisma db seed --schema prisma/schema.prisma",
    "db:admin:reset": "node ../../infra/scripts/run-with-env.mjs node prisma/reset-development-admin.cjs",
    "db:studio": "node ../../infra/scripts/run-with-env.mjs prisma studio --schema prisma/schema.prisma",
    "db:check": "node ../../infra/scripts/run-with-env.mjs node prisma/check.cjs",
    "security:audit-rich-text": "node ../../infra/scripts/run-with-env.mjs ts-node --transpile-only src/infra/security/audit-rich-text.ts",
    "security:sanitize-rich-text": "node ../../infra/scripts/run-with-env.mjs ts-node --transpile-only src/infra/security/audit-rich-text.ts --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.19.0",
    "amqplib": "^0.10.7",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dompurify": "3.4.16",
    "ioredis": "^5.6.1",
    "jsdom": "26.1.0",
    "pdf-lib": "1.17.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.1.1",
    "prisma": "6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@testcontainers/postgresql": "12.2.0",
    "@types/amqplib": "^0.10.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  }
}
